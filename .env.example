# Supabase (required for careers application form)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (required for sending emails)
RESEND_API_KEY=your-resend-api-key
NEXT_PUBLIC_DOMAIN=your-domain.com
NEXT_PUBLIC_ADMIN_EMAIL=admin@your-domain.com

# Bucket for resumes
RESUMES_BUCKET=your-bucket-name

# Upstash Redis (for rate limiting)
UPSTASH_REDIS_REST_URL=https://your-upstash-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Cloudflare Turnstile (for bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Sentry (for error tracking)
SENTRY_AUTH_TOKEN=your-sentry-token

GOOGLE_GENERATIVE_AI_API_KEY=your_google_api

# Chatbot security & rate limits (optional — defaults shown)
# CHAT_RATE_BURST_PER_MIN=15
# CHAT_RATE_HOURLY=80
# CHAT_LLM_DAILY_PER_IP=40
# CHAT_MEMORY_BURST_PER_MIN=12
# CHAT_MEMORY_HOURLY=45
# CHAT_MAX_MESSAGES=12
# CHAT_MAX_USER_CHARS=1500
# CHAT_REQUIRE_SAME_ORIGIN=1
# CHAT_REQUIRE_TURNSTILE=0
# GOOGLE_GENERATIVE_AI_CHAT_MODEL=gemini-2.5-flash-lite


# NEXT_PUBLIC_GA_MEASUREMENT_ID
# NEXT_PUBLIC_CLARITY_PROJECT_ID
# NEXT_PUBLIC_POSTHOG_KEY
# NEXT_PUBLIC_POSTHOG_HOST